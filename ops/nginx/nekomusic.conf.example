# Install as /etc/nginx/conf.d/nekomusic.conf after replacing example.com.
# This file assumes /var/www/nekomusic/current points to a verified dist release.

server {
    listen 80;
    listen [::]:80;
    server_name example.com;

    root /var/www/nekomusic/current;
    index index.html;

    client_max_body_size 2m;

    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    location /assets/ {
        try_files $uri =404;
        expires 1y;
        add_header Cache-Control "public, immutable";
        add_header X-Content-Type-Options "nosniff" always;
    }

    location ~* \.(?:js|css|svg|png|ico|webmanifest|woff2)$ {
        try_files $uri =404;
        expires 1h;
    }

    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache";
    }

    # The browser sends credentials through this same-origin-only header because
    # JavaScript cannot set the protected Cookie header directly. Never log it.
    location /api/netease/ {
        proxy_pass https://music.163.com/;
        proxy_ssl_server_name on;
        proxy_ssl_verify on;
        proxy_ssl_trusted_certificate /etc/ssl/certs/ca-certificates.crt;
        proxy_set_header Host music.163.com;
        proxy_set_header Referer https://music.163.com;
        proxy_set_header Cookie $http_x_neko_upstream_cookie;
        proxy_set_header X-Neko-Upstream-Cookie "";
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_connect_timeout 5s;
        proxy_read_timeout 20s;
        proxy_send_timeout 20s;
        proxy_buffering off;
    }

    # NetEase playback URLs are signed for their original protocol and CDN host.
    # Keep both values unchanged behind a same-origin, allowlisted proxy so the
    # browser never makes mixed-content or cross-origin media requests.
    location ~ ^/api/netease-media/http/(?<netease_http_host>[a-z0-9-]+(?:\.[a-z0-9-]+)*\.music\.126\.net)(?<netease_http_path>/.*)$ {
        resolver 1.1.1.1 8.8.8.8 valid=300s ipv6=off;
        proxy_pass http://$netease_http_host$netease_http_path$is_args$args;
        proxy_set_header Host $netease_http_host;
        proxy_set_header Referer https://music.163.com;
        proxy_set_header Cookie "";
        proxy_set_header X-Neko-Upstream-Cookie "";
        proxy_set_header Range $http_range;
        proxy_set_header If-Range $http_if_range;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_force_ranges on;
        proxy_connect_timeout 5s;
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
        proxy_buffering off;
        add_header Cache-Control "private, max-age=300" always;
        add_header X-Content-Type-Options "nosniff" always;
    }

    location ~ ^/api/netease-media/https/(?<netease_https_host>[a-z0-9-]+(?:\.[a-z0-9-]+)*\.music\.126\.net)(?<netease_https_path>/.*)$ {
        resolver 1.1.1.1 8.8.8.8 valid=300s ipv6=off;
        proxy_pass https://$netease_https_host$netease_https_path$is_args$args;
        proxy_ssl_server_name on;
        proxy_ssl_name $netease_https_host;
        proxy_ssl_verify on;
        proxy_ssl_trusted_certificate /etc/ssl/certs/ca-certificates.crt;
        proxy_set_header Host $netease_https_host;
        proxy_set_header Referer https://music.163.com;
        proxy_set_header Cookie "";
        proxy_set_header X-Neko-Upstream-Cookie "";
        proxy_set_header Range $http_range;
        proxy_set_header If-Range $http_if_range;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_force_ranges on;
        proxy_connect_timeout 5s;
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
        proxy_buffering off;
        add_header Cache-Control "private, max-age=300" always;
        add_header X-Content-Type-Options "nosniff" always;
    }

    location /api/bilibili-audio/ {
        proxy_pass https://www.bilibili.com/;
        proxy_ssl_server_name on;
        proxy_ssl_verify on;
        proxy_ssl_trusted_certificate /etc/ssl/certs/ca-certificates.crt;
        proxy_set_header Host www.bilibili.com;
        proxy_set_header Referer https://www.bilibili.com;
        proxy_set_header Cookie $http_x_neko_upstream_cookie;
        proxy_set_header X-Neko-Upstream-Cookie "";
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_connect_timeout 5s;
        proxy_read_timeout 20s;
        proxy_send_timeout 20s;
    }

    location /api/bilibili/ {
        proxy_pass https://api.bilibili.com/;
        proxy_ssl_server_name on;
        proxy_ssl_verify on;
        proxy_ssl_trusted_certificate /etc/ssl/certs/ca-certificates.crt;
        proxy_set_header Host api.bilibili.com;
        proxy_set_header Referer https://www.bilibili.com;
        proxy_set_header Cookie $http_x_neko_upstream_cookie;
        proxy_set_header X-Neko-Upstream-Cookie "";
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_connect_timeout 5s;
        proxy_read_timeout 20s;
        proxy_send_timeout 20s;
    }

    # Only Bilibili-owned HTTPS CDN subdomains can be reached. The hostname is
    # constrained by this location regex; arbitrary hosts and IPs cannot match.
    location ~ ^/api/bilibili-cdn/(?<cdn_host>[a-z0-9-]+(?:\.[a-z0-9-]+)*\.(?:bilivideo\.com|hdslb\.com))(?<cdn_path>/.*)$ {
        resolver 1.1.1.1 8.8.8.8 valid=300s ipv6=off;
        proxy_pass https://$cdn_host$cdn_path$is_args$args;
        proxy_ssl_server_name on;
        proxy_ssl_name $cdn_host;
        proxy_ssl_verify on;
        proxy_ssl_trusted_certificate /etc/ssl/certs/ca-certificates.crt;
        proxy_set_header Host $cdn_host;
        proxy_set_header Referer https://www.bilibili.com;
        proxy_set_header Cookie "";
        proxy_set_header X-Neko-Upstream-Cookie "";
        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
        proxy_send_timeout 30s;
        proxy_buffering off;
        add_header Cache-Control "private, max-age=300" always;
        add_header X-Content-Type-Options "nosniff" always;
    }

    location /api/ {
        return 404;
    }
}
